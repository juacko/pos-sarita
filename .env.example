# ============================================
# POS Sarita — Variables de Entorno
# ============================================
# Copiar este archivo como .env y ajustar valores

# === Servidor ===
PORT=3000
HTTPS_PORT=3443

# === Sincronización con Oracle Cloud ===
# Habilitar/deshabilitar sincronización
SYNC_ENABLED=false

# URL del servidor de sincronización en Oracle Cloud
# Ejemplo: https://129.151.xxx.xxx:4000
SYNC_SERVER_URL=

# Clave de autenticación compartida entre el POS y el servidor cloud
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SYNC_API_KEY=

# Identificador único de esta PC/terminal
# Usar un nombre descriptivo: pc-dev-1, pc-dev-2, pc-restaurante, etc.
SYNC_DEVICE_ID=pc-dev-1

# Intervalo de sincronización en milisegundos (default: 60000 = 1 minuto)
SYNC_INTERVAL_MS=60000

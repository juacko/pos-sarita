# ============================================
# POS Sarita Cloud Sync API — Variables de Entorno
# ============================================
# Copiar como .env y ajustar valores

# === Base de datos PostgreSQL ===
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pos_sarita
DB_USER=pos_user
DB_PASSWORD=cambiar_esta_clave_segura

# === Servidor ===
PORT=4000

# === Autenticación ===
# Misma clave que configuraste en el POS local (SYNC_API_KEY)
SYNC_API_KEY=cambiar_esta_clave_segura

# === CORS ===
# Dejar vacío para permitir cualquier origen, o especificar IPs
CORS_ORIGIN=*

[req]
default_bits = 2048
prompt = no
default_md = sha256
distinguished_name = dn
x509_extensions = v3_req

[dn]
C = PE
ST = Lima
L = Lima
O = POS Sarita
OU = Restaurante
CN = pos-sarita.local

[v3_req]
subjectAltName = @alt_names
basicConstraints = CA:FALSE
keyUsage = digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth

[alt_names]
DNS.1 = localhost
DNS.2 = pos-sarita.local
IP.1 = 127.0.0.1
IP.2 = 192.168.18.122
IP.3 = 192.168.232.1
IP.4 = 192.168.139.1
